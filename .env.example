# Lumiere Frontend (Lumiere-UI) Environment Configuration

# REST API Base URL
# Option A (Local Backend): http://localhost:8080
# Option B (Production Backend): https://<your-railway-app>.up.railway.app
VITE_API_URL=http://localhost:8080

# Supabase Client Configuration (Optional - Client Safe)
# VITE_SUPABASE_URL=https://<your-supabase-project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Demo Credentials Footer Display (defaults to false in production, true in dev)
# VITE_SHOW_DEMO_CREDENTIALS=false

